{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // DOM is required because Playwright browser-context callbacks in e2e/
    // are typed against real DOM elements.
    "lib": ["ES2024", "ESNext.Collection", "ESNext.Float16", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // Only the tooling project relaxes this. Vite/Vitest ship .d.ts files that
    // do not survive exactOptionalPropertyTypes, and one of them references a
    // module pnpm does not hoist. The application project (tsconfig.app.json)
    // keeps skipLibCheck false, which is where the guarantee matters.
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["e2e", "*.ts", "*.js", "*.mjs", ".dependency-cruiser.mjs"]
}
