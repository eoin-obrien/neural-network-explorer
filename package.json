{
  "name": "neural-network-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "A pedagogical explorer for small dense feed-forward neural networks.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "24.13.1",
    "pnpm": "11.15.0"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:lint": "markdownlint-cli2",
    "spellcheck": "cspell lint --no-progress",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "architecture": "depcruise src e2e",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "size": "size-limit",
    "commitlint": "commitlint",
    "check": "pnpm format:check && pnpm docs:lint && pnpm spellcheck && pnpm typecheck && pnpm lint && pnpm architecture && pnpm knip && pnpm test:coverage && pnpm build && pnpm size",
    "verify": "pnpm check && pnpm test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/charts": "9.6.0",
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.0.3",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "cspell": "10.3.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
