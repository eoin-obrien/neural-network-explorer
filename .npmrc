# Exact versions only: this reference repository upgrades deliberately, never by
# semver drift.
save-exact=true

# Refuse to install under an undeclared Node/pnpm version rather than failing
# later with a confusing runtime error.
engine-strict=true

# Peer-dependency conflicts are real compatibility problems here, not noise.
strict-peer-dependencies=true

# Recharts reaches the runtime as the peer dependency Mantine Charts requires.
auto-install-peers=true
